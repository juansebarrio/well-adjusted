# All optional. With a variable unset, the matching block shows a mono notice instead of breaking.
# Set them in Vercel → Project → Settings → Environment Variables.

# Substack publication root, no trailing slash. The enrolment form opens {SUBSTACK_URL}/subscribe?email=...
SUBSTACK_URL=
# Instagram profile URL (footer).
INSTAGRAM_URL=
# The client's address, shown on /say-hello as a mailto link.
CONTACT_EMAIL=
# Tally share URLs, e.g. https://tally.so/r/abc123 (embed URLs also work).
TALLY_LETTER_OFFICE_URL=
TALLY_CONTACT_URL=
# Plausible script URL. Only loaded on the Vercel production deployment.
PLAUSIBLE_SRC=
