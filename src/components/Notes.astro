---
import { a11y } from '../copy';
interface Props { items: string[]; heading?: string }
const { items, heading = a11y.notesLabel } = Astro.props;
---
{
  items.length > 0 && (
    <section class="footnotes" data-footnotes aria-labelledby="notes-heading">
      <h2 id="notes-heading">{heading}</h2>
      <ol>
        {items.map((text, i) => (
          <li id={`note-${i + 1}`}>
            <p>
              {text}{'\u00a0'}
              <a href={`#noteref-${i + 1}`} data-footnote-backref aria-label={`Back to reference ${i + 1}`}>↩</a>
            </p>
          </li>
        ))}
      </ol>
    </section>
  )
}
