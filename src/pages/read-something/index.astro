---
import Base from '../../layouts/Base.astro';
import { read } from '../../copy';
import { getEssays, essayLabel, typo } from '../../lib';

const essays = await getEssays();
---
<Base title={read.title} description={read.description}>
  <div class="shell mt-12 sm:mt-16">
    <div class="sheet">
      <p class="label sheet-margin wide:pt-3">{read.formRef}</p>
      <header class="sheet-body">
        <h1 class="display">{read.heading}</h1>
        <p class="lede mt-5">{read.lede}</p>
      </header>
    </div>

    <div class="sheet mt-10 sm:mt-12">
      <div class="sheet-body">
        {essays.length === 0 && <p class="mono border-t border-blue pt-4">{read.empty}</p>}
        <ol>
          {
            essays.map((entry) => {
              const title = typo(entry.data.title);
              const href = `/read-something/${entry.id}`;
              const event = { 'data-event': 'essay_open', 'data-props': JSON.stringify({ slug: entry.id, destination: 'site' }) };
              return (
                <li class="border-t border-blue py-6">
                  <article>
                    <p class="label">{essayLabel(entry)}</p>
                    {entry.data.status !== 'final' && <p class="notice mt-1">{read.draftLabel}</p>}
                    <h2 class="mt-3 text-[clamp(1.75rem,5vw,2.5rem)] leading-[1.08]">
                      <a class="text-ink no-underline hover:text-blue" href={href} {...event}>{title}</a>
                    </h2>
                    <p class="mt-2 text-[1.1875rem] italic">{typo(entry.data.deck)}</p>
                    <p class="mt-2">
                      <a class="arrow-link" href={href} {...event} aria-label={`${read.readHere}: ${title}`}>{read.readHere} →</a>
                    </p>
                  </article>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </div>
</Base>
