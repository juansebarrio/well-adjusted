---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import Enrolment from '../../components/Enrolment.astro';
import { essay as copy, read, enrolment } from '../../copy';
import { getEssays, essayLabel, typo } from '../../lib';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'essays'> }
const { entry } = Astro.props;
const { form, filedUnder, readingTime, status } = entry.data;
const title = typo(entry.data.title);
const deck = typo(entry.data.deck);
const { Content } = await render(entry);
---
<Base title={title} description={deck} ogType="article" noindex={status !== 'final'}>
  <article class="shell mt-12 sm:mt-16">
    <div class="sheet">
      <p class="label sheet-margin wide:pt-3">{essayLabel(entry)}</p>
      <header class="sheet-body">
        <h1 class="essay-title">{title}</h1>
        <p class="lede mt-5 italic">{deck}</p>
        <p class="label mt-6">
          {copy.formPrefix} {form} · {read.filedUnder}: {filedUnder} · {read.readingTime}: {readingTime}
        </p>
        {status !== 'final' && <p class="notice mt-1">{read.draftLabel}</p>}
      </header>
    </div>

    <div class="sheet mt-8 sm:mt-10">
      <div class="sheet-body prose essay" data-notes-column>
        <Content />
      </div>
    </div>

    <div class="sheet mt-10">
      <div class="sheet-body flex justify-end">
        <Stamp text={copy.stamp} tilt={-3} class="mr-2" />
      </div>
    </div>

    <div class="sheet mt-10">
      <div class="sheet-body">
        <Enrolment variant="small" id="enrol-next" label={enrolment.afterEssay} />
      </div>
    </div>

    <div class="sheet mt-10">
      <p class="sheet-body"><a class="arrow-link" href="/read-something">← {copy.back}</a></p>
    </div>
  </article>
</Base>

<script>
  // Essay footnotes stay printed at the foot of the page on every screen.
  document.querySelector('.essay .footnotes')?.setAttribute('data-persist', '');
</script>
