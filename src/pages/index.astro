---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bb from '../components/Bb.astro';
import Stamp from '../components/Stamp.astro';
import Enrolment from '../components/Enrolment.astro';
import SpecimenCard from '../components/SpecimenCard.astro';
import NoteRef from '../components/NoteRef.astro';
import Notes from '../components/Notes.astro';
import { home, site } from '../copy';

const specimens = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base title={home.title} home>
  <div class="shell">
    <div class="mono flex flex-wrap justify-between gap-x-8 gap-y-1 pt-3 text-ink-soft">
      <p>{home.notice.join(' · ')}</p>
      <p>{home.issue}</p>
    </div>

    <h1 class="masthead mt-10 sm:mt-14">
      {site.mastheadLead} <span class="mark">{site.mastheadMark}</span>
    </h1>

    <div class="hero mt-8 sm:mt-10">
      <p class="tagline [grid-area:tagline]">
        {site.tagline} <span class="marker">{site.taglineMarked}</span>
      </p>
      <p class="lede measure [grid-area:what]">{site.whatItIs}</p>

      <div class="[grid-area:filed]" data-notes-column>
        <h2 class="label">{home.filedLabel}</h2>
        <dl class="mono mt-2">
          {
            home.filed.map((row, i) => (
              <div class="flex gap-2">
                <dt class="whitespace-nowrap text-blue">{row.field}{row.field === 'Dept.' ? '' : ':'}</dt>
                <dd>{i === home.filed.length - 1 ? <NoteRef n={1}>{row.value}</NoteRef> : row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="[grid-area:stamp] self-center justify-self-start pl-2 wide:self-start wide:pl-0 wide:pt-9">
        <Stamp text={home.stamp} tilt={-5} />
      </div>

      <div class="[grid-area:bb] justify-self-end wide:self-start">
        <Bb size={108} />
      </div>
    </div>

    <div class="sheet mt-12 sm:mt-16">
      <div class="sheet-body">
        <Enrolment />
      </div>
    </div>

    <section class="mt-14 sm:mt-16" aria-labelledby="specimens-title">
      <div class="sheet">
        <h2 id="specimens-title" class="label sheet-margin">{home.specimensLabel}</h2>
        <p class="sheet-body lede" data-notes-column>
          <NoteRef n={2}>{home.specimensLede}</NoteRef>
        </p>
      </div>
      <ul class="mt-6 grid gap-x-10 sm:grid-cols-3">
        {specimens.map((project) => <li><SpecimenCard project={project} /></li>)}
      </ul>
      <p class="mt-4"><a class="arrow-link" href="/projects">{home.specimensAll} →</a></p>
    </section>

    <div class="sheet"><div class="sheet-body"><Notes items={home.notes} /></div></div>

    <p class="mono mt-14 text-ink-soft">{home.closing}</p>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'tagline tagline'
      'what what'
      'filed filed'
      'stamp bb';
    column-gap: 1rem;
    row-gap: 1.25rem;
  }
  @media (min-width: 70rem) {
    .hero {
      grid-template-columns: 10.5rem minmax(0, 41rem) minmax(0, 1fr);
      grid-template-areas:
        '. tagline bb'
        '. what bb'
        'stamp filed .';
      column-gap: 2.5rem;
      row-gap: 1.5rem;
    }
  }
</style>
