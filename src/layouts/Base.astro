---
import '@fontsource-variable/libre-bodoni/wght.css';
import '@fontsource-variable/libre-bodoni/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import bodoniUrl from '@fontsource-variable/libre-bodoni/files/libre-bodoni-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, a11y } from '../copy';
import { ANALYTICS_ON, PLAUSIBLE_SRC, SITE_DOMAIN } from '../config';

interface Props {
  title: string;
  description?: string;
  home?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}
const { title, description = site.description, home = false, noindex = false, ogType = 'website' } = Astro.props;

const fullTitle = home ? title : `${title} — ${site.name}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F4F1EA" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={bodoniUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} ${site.tagline} ${site.taglineMarked}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      ANALYTICS_ON && (
        <>
          <script is:inline defer data-domain={SITE_DOMAIN} src={PLAUSIBLE_SRC} />
          <script is:inline>
            window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#content">{a11y.skip}</a>
    <Header home={home} />
    <main id="content">
      <slot />
    </main>
    <Footer showBb={!home} />
    <script>
      import '../scripts/notes.ts';
      import '../scripts/events.ts';
    </script>
  </body>
</html>
